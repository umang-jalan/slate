# Database - replace with your Supabase/PostgreSQL URL
DATABASE_URL="postgresql://user:password@localhost:5432/interview_prep"

# NextAuth
AUTH_SECRET="replace-with-a-random-secret-run-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Single-user credentials
AUTH_USERNAME="admin"
# Generate hash: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)"
AUTH_PASSWORD_HASH="$2a$10$placeholder-replace-with-real-hash"
